<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup Label="Optimizely CMS 13">
    <!-- Verified versions — https://nuget.optimizely.com. CMS 13 requires .NET 10; EPiServer.Shell is now
         a normal top-level dependency (no longer avoided in favor of EPiServer.CMS.UI.Core for IMenuProvider). -->
    <PackageVersion Include="EPiServer.CMS.Core" Version="13.4.0" />
    <PackageVersion Include="EPiServer.CMS.UI.Core" Version="13.4.0" />
    <PackageVersion Include="EPiServer.CMS" Version="13.4.0" />
    <PackageVersion Include="EPiServer.CMS.AspNetCore.Templating" Version="13.4.0" />
    <PackageVersion Include="EPiServer.Framework.AspNetCore" Version="13.4.0" />
    <PackageVersion Include="EPiServer.Hosting" Version="13.4.0" />
    <PackageVersion Include="EPiServer.Cms.UI.AspNetIdentity" Version="13.4.0" />
    <PackageVersion Include="EPiServer.Shell" Version="13.4.0" />
    <PackageVersion Include="OpenTelemetry.Api" Version="1.20.0" />
  </ItemGroup>
  <ItemGroup Label="Library Dependencies">
    <PackageVersion Include="Bogus" Version="35.6.5" />
    <PackageVersion Include="Dapper" Version="2.1.89" />
    <PackageVersion Include="MinVer" Version="8.0.0" />
    <PackageVersion Include="OpenAI" Version="2.14.0" />
    <PackageVersion Include="Anthropic" Version="12.58.0" />
    <PackageVersion Include="Anthropic.Bedrock" Version="0.14.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.11.0" />
    <PackageVersion Include="OllamaSharp" Version="5.5.0" />
    <PackageVersion Include="TechnicalDogsbody.MicroMediator" Version="1.5.0" />
  </ItemGroup>
  <!-- Transitive overrides: pin to satisfy EPiServer.CMS.Core constraints and resolve known vulnerabilities -->
  <ItemGroup Label="Transitive Overrides">
    <!-- EPiServer.CMS.Core requires Castle.Core >= 5.2.1 && < 6.0.0 (Castle.Windsor itself is no longer a CMS dependency) -->
    <PackageVersion Include="Castle.Core" Version="5.2.1" />
    <!-- MimeKit/MailKit < 4.16.0 have known CVEs (GHSA-9j88-vvj5-vhgr) — override to patched release -->
    <PackageVersion Include="MimeKit" Version="4.18.1" />
    <PackageVersion Include="MailKit" Version="4.18.1" />
    <!-- MessagePack 2.5.192 (via Aspire.Hosting.AppHost) has multiple known CVEs — override to patched 2.x release.
         3.x is a breaking major and is intentionally not taken. -->
    <PackageVersion Include="MessagePack" Version="2.5.307" />
    <!-- SQLitePCLRaw.lib.e_sqlite3 <= 2.1.11 bundles a vulnerable SQLite (CVE-2025-6965, GHSA-2m69-gcr7-jv3q) — override to patched release -->
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <!-- SixLabors.ImageSharp <= 4.1.1 has known advisories (GHSA-gwg2-r3hj-4w44, GHSA-j3p4-wp97-rph4, GHSA-j9gm-c75j-xc9q, GHSA-jjfr-hcj7-qf5w, GHSA-wmxv-xphr-5c9g) — override to patched 4.x release. Transitive only; not referenced directly. -->
    <PackageVersion Include="SixLabors.ImageSharp" Version="4.1.3" />
    <!-- System.Security.Cryptography.Pkcs/Xml < 10.0.13 have known advisories (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx, GHSA-7hqp-7c5m-4vq6, GHSA-c399-9853-6jmj, GHSA-r955-8q5j-3h83) — override to patched release -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup Label="Aspire + ServiceDefaults (demo only)">
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.6.1" />
    <PackageVersion Include="Aspire.Hosting.SqlServer" Version="13.6.1" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.11.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.0" />
  </ItemGroup>
  <ItemGroup Label="Test Frameworks">
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="Moq" Version="4.21.0" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
  </ItemGroup>
</Project>
