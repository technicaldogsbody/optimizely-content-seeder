<Project Sdk="Microsoft.NET.Sdk.Web">

  <Import Project="..\ContentSeederSource.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TechnicalDogsbody.Optimizely.ContentSeeder.Demo</RootNamespace>
    <AssemblyName>TechnicalDogsbody.Optimizely.ContentSeeder.Demo</AssemblyName>
    <IsPackable>false</IsPackable>
    <UserSecretsId>contentseeder-demo</UserSecretsId>
  </PropertyGroup>

  <!-- ContentSeeder comes from the source projects, or from ../local-packages when ContentSeederUseLocalPackages=true. -->
  <ItemGroup Condition="'$(ContentSeederUseLocalPackages)' != 'true'">
    <ProjectReference Include="..\..\src\TechnicalDogsbody.Optimizely.ContentSeeder\TechnicalDogsbody.Optimizely.ContentSeeder.csproj" />
    <ProjectReference Include="..\..\src\TechnicalDogsbody.Optimizely.ContentSeeder.Connector.Optimizely13\TechnicalDogsbody.Optimizely.ContentSeeder.Connector.Optimizely13.csproj" />
    <ProjectReference Include="..\..\src\TechnicalDogsbody.Optimizely.ContentSeeder.AI\TechnicalDogsbody.Optimizely.ContentSeeder.AI.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(ContentSeederUseLocalPackages)' == 'true'">
    <PackageReference Include="TechnicalDogsbody.Optimizely.ContentSeeder" VersionOverride="$(ContentSeederPackageVersion)" />
    <PackageReference Include="TechnicalDogsbody.Optimizely.ContentSeeder.AI" VersionOverride="$(ContentSeederPackageVersion)" />
    <PackageReference Include="TechnicalDogsbody.Optimizely.ContentSeeder.Connector.Optimizely13" VersionOverride="$(ContentSeederPackageVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TechnicalDogsbody.Optimizely.ContentSeeder.Demo.ServiceDefaults\TechnicalDogsbody.Optimizely.ContentSeeder.Demo.ServiceDefaults.csproj" />
    <PackageReference Include="EPiServer.CMS" />
    <PackageReference Include="EPiServer.Cms.UI.AspNetIdentity" />
    <PackageReference Include="EPiServer.Framework.AspNetCore" />
    <PackageReference Include="EPiServer.Hosting" />
    <!-- Vendor SDKs the demo can plug into the AI provider (see Startup). -->
    <PackageReference Include="OllamaSharp" />
    <PackageReference Include="Anthropic" />
    <PackageReference Include="Anthropic.Bedrock" />
    <PackageReference Include="OpenTelemetry.Api" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="modules\_protected\TechnicalDogsbody.Optimizely.ContentSeeder\" />
  </ItemGroup>

  <!-- Import plugin targets so the module zip and UI assets are copied on build.
       NuGet does this automatically for packages; project references need an explicit import. -->
  <Import Project="..\..\src\TechnicalDogsbody.Optimizely.ContentSeeder\TechnicalDogsbody.Optimizely.ContentSeeder.targets" Condition="'$(ContentSeederUseLocalPackages)' != 'true'" />
  <Import Project="..\..\src\TechnicalDogsbody.Optimizely.ContentSeeder.Connector.Optimizely13\TechnicalDogsbody.Optimizely.ContentSeeder.targets" Condition="'$(ContentSeederUseLocalPackages)' != 'true'" />

</Project>
