@model ProductPage
@{
    ViewData["Title"] = Model.Name;
}

<section class="page-section">
    <div class="container split">
        @if (!ContentReference.IsNullOrEmpty(Model.ProductImage))
        {
            <img class="feature-image" style="margin-top:0" src="@Url.ContentUrl(Model.ProductImage)" alt="@Model.ProductName" />
        }
        <div>
            <span class="eyebrow">Product</span>
            <h1>@(string.IsNullOrWhiteSpace(Model.ProductName) ? Model.Name : Model.ProductName)</h1>
            <p class="price">@Model.Price.ToString("C")</p>
            <p class="stock @(Model.InStock ? "stock--in" : "stock--out")">@(Model.InStock ? "● In stock" : "○ Out of stock")</p>
            @if (Model.Description != null)
            {
                <div class="rich-text muted">@Html.PropertyFor(m => m.Description)</div>
            }
        </div>
    </div>
</section>

@if (Model.TeaserArea != null)
{
    <section class="page-section">
        <div class="container">
            <span class="eyebrow">Related</span>
            <h2>You might also like</h2>
            @Html.PropertyFor(m => m.TeaserArea, new { CssClass = "teaser-list" })
        </div>
    </section>
}
