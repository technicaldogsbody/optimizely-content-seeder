# Copy this file to .env and fill in your own values.
# .env is gitignored and must never be committed.

# SQL Server SA password — must meet complexity requirements:
# >= 8 characters, uppercase, lowercase, digit, and symbol.
MSSQL_SA_PASSWORD=

# Host port to expose SQL Server on. Change if 1433 is already in use.
MSSQL_HOST_PORT=1433
