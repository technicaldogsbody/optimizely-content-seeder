<?xml version="1.0" encoding="utf-8"?>
<!-- Used by the demos only when ContentSeederUseLocalPackages=true (see ContentSeederSource.props). Same sources as the root nuget.config, plus the local packages folder. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="Optimizely" value="https://api.nuget.optimizely.com/v3/index.json" protocolVersion="3" />
    <add key="local-packages" value="../local-packages" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="Optimizely">
      <package pattern="EPiServer" />
      <package pattern="EPiServer.*" />
      <package pattern="Optimizely.*" />
    </packageSource>
    <packageSource key="local-packages">
      <package pattern="TechnicalDogsbody.Optimizely.ContentSeeder*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
