@using EPiServer.Core
@model TechnicalDogsbody.Optimizely.ContentSeeder.Demo12.Controllers.ArticleListingViewModel
@{
    var listing = Model.Page;
    ViewData["Title"] = listing.Name;

    // Previous/next and each page number, with the current page marked for assistive technology.
    string PageUrl(int number) => $"{Url.ContentUrl(listing.ContentLink)}?page={number}";
}

<header class="page-intro">
    <div class="container">
        <span class="eyebrow">Articles</span>
        <h1>@(string.IsNullOrWhiteSpace(listing.Title) ? listing.Name : listing.Title)</h1>
        @if (!string.IsNullOrWhiteSpace(listing.Introduction))
        {
            <p class="lead">@listing.Introduction</p>
        }
        <p class="meta">
            <span>@Model.TotalArticles @(Model.TotalArticles == 1 ? "article" : "articles")</span>
        </p>
    </div>
</header>

<section class="page-section">
    <div class="container">
        @if (Model.Articles.Count == 0)
        {
            <p class="muted">There are no articles yet.</p>
        }
        else
        {
            <div class="card-grid card-grid--three">
                @foreach (var article in Model.Articles)
                {
                    <a class="card" href="@Url.ContentUrl(article.ContentLink)">
                        @if (!ContentReference.IsNullOrEmpty(article.HeroImage))
                        {
                            <img class="card-media" src="@Url.ContentUrl(article.HeroImage)" alt="" loading="lazy" />
                        }
                        <div class="card-body">
                            <span class="card-kicker">@article.PublishedDate.ToString("d MMM yyyy")</span>
                            <h3>@(string.IsNullOrWhiteSpace(article.Title) ? article.Name : article.Title)</h3>
                            @if (!string.IsNullOrWhiteSpace(article.Introduction))
                            {
                                <p>@article.Introduction</p>
                            }
                        </div>
                    </a>
                }
            </div>
        }

        @if (Model.PageCount > 1)
        {
            <nav class="pager" aria-label="Article pages">
                @if (Model.CurrentPage > 1)
                {
                    <a class="pager-link" href="@PageUrl(Model.CurrentPage - 1)" rel="prev">&larr; Newer</a>
                }
                @for (var n = 1; n <= Model.PageCount; n++)
                {
                    @if (n == Model.CurrentPage)
                    {
                        <span class="pager-link is-current" aria-current="page">@n</span>
                    }
                    else
                    {
                        <a class="pager-link" href="@PageUrl(n)">@n</a>
                    }
                }
                @if (Model.CurrentPage < Model.PageCount)
                {
                    <a class="pager-link" href="@PageUrl(Model.CurrentPage + 1)" rel="next">Older &rarr;</a>
                }
            </nav>
        }
    </div>
</section>
